# MySQL local development (no Docker)
DATABASE_URL="mysql://bunk24_app:CHANGE_ME@localhost:3306/bunk24_gallery"

# API
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=replace-this-with-a-long-random-local-secret
JWT_EXPIRE_MINUTES=60

# Admin API access. Set a long random value locally; never expose it as NEXT_PUBLIC_*.
ADMIN_API_KEY=replace-this-with-a-long-random-admin-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-seeding

# Printify integration (server-side only; optional until configured)
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_WEBHOOK_SECRET=

# Payments remain disabled until Stripe is configured
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
